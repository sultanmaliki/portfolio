# Cloudflare Pages custom headers (copied to the export root as out/_headers)

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://api.github.com; worker-src 'self' blob:; frame-src https:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# Content-hashed build assets never change
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# 150 scroll frames per set (720p + 1080p): cache for a month so repeat visits are instant.
# These URLs are NOT content-hashed: if you ever replace the frames, rename the folder
# (e.g. sequence-720-v2 -> sequence-720-v3, and update ScrollyCanvas) so cached copies can't go stale.
/sequence-720-v2/*
  Cache-Control: public, max-age=2592000

/sequence-hd-v2/*
  Cache-Control: public, max-age=2592000

/og.jpg
  Cache-Control: public, max-age=86400

# Whoever saves the resume (built-in reader, raw PDF tab, "Save as") gets a proper file name
/resume.pdf
  Content-Disposition: inline; filename="Syed_Mohammed_Sultan_Resume.pdf"
